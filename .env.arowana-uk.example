# ============================================================================
#  .env for the live copy at: https://arowana.uk/hrm   (sign in: /hrm/login)
# ============================================================================
#  On the server the project is in  public_html/arowanauk/hrm  (arowana.uk's web
#  root is public_html/arowanauk), so artisan sits at public_html/arowanauk/hrm/artisan.
#  Copy this file to  public_html/arowanauk/hrm/.env  and fill in the two blanks
#  marked  <-- FILL.
#
#  - The database is NOT set here: it is in config/database.php (host, name,
#    user, password). Edit that file on the server.
#  - No passwords or keys are kept in this file (it is in git). If the server
#    already has a .env, keep its APP_KEY: encrypted settings (the biometric
#    password, SMTP password) were sealed with it and cannot be read with a new one.
#  - Mail (SMTP) is set in the app: Settings -> Notification Settings -> Email.
#  - The biometric connection is set in the app: Settings -> Biometric Settings.
#  - The two .htaccess files need no change for a sub folder: they serve
#    https://arowana.uk/hrm/... from hrm/public without "/public" in the address,
#    send http to https, send old ".../hrm/public/..." links to ".../hrm/...", and
#    never serve .env* files.
# ============================================================================

APP_NAME="Arowana HR Portal"

# production: no error details on screen, and Laravel refuses destructive
# commands (migrate:fresh, db:wipe) so live data cannot be wiped by mistake.
APP_ENV=production
APP_DEBUG=false

# <-- FILL: the server's existing key (or run "php artisan key:generate" once on a
#     brand-new install, before anything is saved).
APP_KEY=

# Every link, redirect, e-mail link and asset is built from this: the sub folder
# included, no trailing slash, no "/public".
APP_URL=https://arowana.uk/hrm

# Links and assets always https (needed behind a proxy / Cloudflare too).
REDIRECT_HTTPS=true

# The sign-in cookie: only over https, only for /hrm (not sent to other sites on
# arowana.uk), and with its own name so it never mixes with another app's.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/hrm
SESSION_COOKIE=arowana_hrm_session

LOG_CHANNEL=daily
LOG_LEVEL=error

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=null

# Scheduled jobs (biometric pulls every 5 minutes, attendance build, reminders)
# run here only. Needs one cron entry on the server, every minute:
#   * * * * * cd /home/<cpanel-user>/public_html/arowanauk/hrm && php artisan schedule:run >> /dev/null 2>&1
# If arowanaone.com runs from the same database, keep the scheduler on in ONE of
# the two copies only (SCHEDULER_ENABLED=false in the other), or every job runs twice.
SCHEDULER_ENABLED=true

# Pages open in place (no white flash); false = every link a full page load.
PAGE_SWAP_ENABLED=true

# Biometric (iApp): used only until Settings -> Biometric Settings is saved once;
# after that the settings screen is the only source.
IAPP_API_BASE_URL=https://106.51.5.128/iapp
IAPP_VERIFY_SSL=false
IAPP_AUTH_METHOD=user
IAPP_USERNAME=Administrator
# <-- FILL only if Biometric Settings has never been saved on the server.
IAPP_PASSWORD=
IAPP_COMPANY_CODE=01
IAPP_LOCATION_CODE=
IAPP_TOKEN_CACHE_MINUTES=15
