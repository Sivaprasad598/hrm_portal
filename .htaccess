# Project root. Works unchanged in every place it is put (no RewriteBase anywhere):
#   live:  public_html/arowanaone.com  -> https://arowanaone.com/login     (domain root)
#   live:  public_html/arowanauk/hrm   -> https://arowana.uk/hrm/login     (sub folder)
#   local: C:/wamp64/www/hrm_portal    -> http://localhost/hrm_portal/login
#
# The application lives in public/, but the address has no "/public" in it.
# Every request is handed to public/ internally, so nothing outside public/ is
# ever served: .env (passwords), storage/ and its backups, vendor/, the source
# code, the HR Excel sheets and the legacy PHP pages (those run only through the
# application, after sign-in). public/index.php tells the framework it sits at
# this folder, so every link it builds leaves "/public" out too (APP_URL in .env
# must match: https://arowanaone.com, https://arowana.uk/hrm, http://localhost/hrm_portal;
# see .env.arowanaone.example and .env.arowana-uk.example).

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Plain http goes to https (the password and the API token travel in the
    # request), also behind a proxy. Not on this machine, which has no certificate.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,NE,L]

    # The API's bearer token must reach PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # SSL certificate checks (cPanel AutoSSL / Let's Encrypt) are answered from
    # here, not from public/, or the certificate stops renewing.
    RewriteRule ^\.well-known/ - [L]

    # The application's own files are never served from the root.
    RewriteRule ^(\.env.*|\.git(/.*)?|composer\.(json|lock)|package(-lock)?\.json|artisan)$ - [F,L,NC]
    RewriteRule ^[^/]+\.(sql|xlsx|log|sh|bak|zip)$ - [F,L,NC]

    # The installer and the purchase check stay closed on an installed site
    # (take this line out only while deliberately running a fresh install).
    RewriteRule ^(public/)?(install|verify-purchase)(/.*)?$ - [F,L,NC]

    # (Old links with "/public" in them are sent to the clean address by
    # public/.htaccess: Apache runs only that file for anything under public/.)

    # Everything else is served from public/, without it showing.
    RewriteRule ^(?!public(?:/|$))(.*)$ public/$1 [L]
</IfModule>

# With or without mod_rewrite: no secrets from the root.
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|.*\.(sql|log))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
