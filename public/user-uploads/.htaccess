# Uploaded files are served as files, never run: a .php dropped in here is refused.
# Written for Apache 2.4 (Require) with the 2.2 form as a fallback, so it works
# whether or not mod_access_compat is loaded (without it, "Order/Deny" alone made
# every file in this folder a 500).
Options -Indexes

<FilesMatch "\.(php|php\.|phtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
