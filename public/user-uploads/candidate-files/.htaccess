# Candidates' resumes, documents and signed offers are personal data: they are
# never served from here directly, only by the app after sign-in to someone who
# may see them (CandidateController@file). Apache 2.4 form, with 2.2 fallback.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
